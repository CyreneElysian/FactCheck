# ============================================================================
# FactCheck .gitignore
# 目标：排除依赖、构建产物、运行数据与全部真实密钥
# ============================================================================

# ---------------------------------------------------------------------------
# 敏感配置（绝不提交真实密钥）
# ---------------------------------------------------------------------------
.env
.env.local
.env.*.local
application-local.yml
application-local.yaml
*.local.yml
*.local.yaml

# ---------------------------------------------------------------------------
# IDE / 编辑器
# ---------------------------------------------------------------------------
.idea/
*.iml
*.ipr
*.iws
.vscode/
*.swp
*.swo

# ---------------------------------------------------------------------------
# 操作系统
# ---------------------------------------------------------------------------
Thumbs.db
Desktop.ini
.DS_Store

# ---------------------------------------------------------------------------
# Java / Maven
# ---------------------------------------------------------------------------
target/
*.class
*.jar
*.war
dependency-reduced-pom.xml
.mvn/timing.properties

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# 模型权重（约 190MB，首次运行按 .env 的 EMBEDDING_MODEL 自动下载）
fact-agent/models/

# 向量索引与元数据（运行时数据，启动时自动创建）
fact-agent/data/

# ---------------------------------------------------------------------------
# PyTorch Inductor 编译缓存
#
# torch 默认把编译缓存建在**进程的当前工作目录**下，目录名规则是
# `torchinductor_<当前系统用户名>`（例如 `torchinductor_陈伟博`）。
# 于是从哪个目录启动 Python，就会在哪个目录留下一个空目录：
#   cd fact-agent && python -m unittest ...   → fact-agent/torchinductor_<用户名>
#   python eval/evaluate.py                   → fact-agent/eval/torchinductor_<用户名>
#
# 本项目只用 torch 做推理（sentence-transformers 编码文本），不编译内核，
# 实际缓存永远是空的。这里按目录名加两条兜底忽略；另外 settings 里已把
# TORCHINDUCTOR_CACHE_DIR 指向系统临时目录，正常情况下不会再生成在项目内。
# ---------------------------------------------------------------------------
torchinductor_*/
**/torchinductor_*/

# ---------------------------------------------------------------------------
# 微信开发者工具：私有配置（个人设置，官方建议不入库）
# ---------------------------------------------------------------------------
project.private.config.json

# ---------------------------------------------------------------------------
# 前端
# ---------------------------------------------------------------------------
node_modules/
dist/
.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.eslintcache

# 前端构建的临时目录与缓存：由 fact-check-web/.npmrc 指向项目内，
# 目的是规避 Windows 上"安全软件/同步盘锁住 %TEMP% 里 esbuild 临时文件"导致的
# `Access is denied`（见 .npmrc 注释）。这些目录是构建副产物，不入库。
fact-check-web/.tmp/
fact-check-web/.npm-cache/

# ---------------------------------------------------------------------------
# Nginx：只保留 conf/（本项目实际修改过的配置）与占位页面
# ---------------------------------------------------------------------------
nginx-1.20.2/nginx.exe
nginx-1.20.2/contrib/
nginx-1.20.2/docs/
nginx-1.20.2/logs/
nginx-1.20.2/temp/
# 前端构建产物，由 fact-check-web 构建后复制而来，不入库
nginx-1.20.2/html/fact-check/

# ---------------------------------------------------------------------------
# 日志与临时文件
# ---------------------------------------------------------------------------
*.log
*.tmp
*.bak
