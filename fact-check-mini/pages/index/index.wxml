<view class="container">
  <view class="card">
    <view class="title">事实检测</view>
    <picker mode="selector" range="{{categories}}" value="{{categoryIndex}}" bindchange="onCategoryChange">
      <view class="picker">分类：{{categories[categoryIndex]}}</view>
    </picker>
    <textarea class="textarea" placeholder="请输入要诊断的消息（1-5000字）" maxlength="5000" value="{{content}}" bindinput="onContentInput"></textarea>
    <button class="btn-primary" loading="{{submitting}}" bindtap="onSubmit">提交检测</button>
    <button class="btn-plain" style="margin-top: 16rpx" bindtap="onChooseImage">上传图片识别</button>
  </view>

  <view class="card" wx:if="{{result}}">
    <view class="title">检测结果</view>
    <view wx:if="{{result.status === 0}}" class="muted">正在检测，请稍候...</view>
    <block wx:else>
      <view wx:if="{{result.authorityInfo}}" class="authority-hit">
        已命中权威信息：{{result.authorityInfo.title}}
      </view>
      <view class="{{verdictClass}}">结论：{{verdictText}}</view>
      <view wx:if="{{result.reasoningChain}}" class="muted">推理链：{{result.reasoningChain}}</view>
      <view wx:if="{{result.aiSummary}}" class="muted">AI 说明：{{result.aiSummary}}</view>
      <button class="btn-plain" style="margin-top: 16rpx" bindtap="goDetail">查看详情/申诉/收藏</button>
    </block>
  </view>
</view>
