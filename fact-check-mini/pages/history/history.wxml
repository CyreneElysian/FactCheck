<view class="container">
  <view class="card" wx:for="{{records}}" wx:key="id" data-id="{{item.id}}" bindtap="goDetail">
    <view class="row">
      <text class="muted">#{{item.id}}</text>
      <text class="{{item.verdictClass}}">{{item.verdictText}}</text>
    </view>
    <view style="margin: 12rpx 0">{{item.content}}</view>
    <view class="row">
      <text class="muted">{{item.category || '未分类'}}　{{item.createTime || ''}}</text>
      <text class="muted">详情 ›</text>
    </view>
  </view>

  <view wx:if="{{loading}}" class="muted list-tip">加载中…</view>
  <view wx:elif="{{finished && records.length}}" class="muted list-tip">没有更多了（共 {{total}} 条）</view>
  <empty wx:if="{{!loading && !records.length}}" text="暂无历史记录"></empty>
</view>
