.mine-header {
  background: #409eff;
  color: #fff;
  border-radius: 16rpx;
  padding: 40rpx 30rpx;
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}
.avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: #fff;
  color: #409eff;
  font-size: 44rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
}
.nickname { font-size: 34rpx; font-weight: bold; }

/* 管理员角色标识（放在头像区右侧，让管理员一眼看出当前是管理端视图） */
.role-badge {
  margin-left: auto;
  padding: 6rpx 18rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.25);
  border: 1rpx solid rgba(255, 255, 255, 0.6);
  font-size: 22rpx;
  color: #ffffff;
}
.menu-item {
  display: flex;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}
.menu-item:last-child { border-bottom: none; }
.arrow { color: #c0c0c0; font-size: 36rpx; }

/* 头像（有图时显示图片，无图时显示首字母） */
.avatar-img { display: block; }

/* 菜单左侧：文字 + 未读红点 */
.menu-left {
  justify-content: flex-start;
}

.badge-dot {
  margin-left: 12rpx;
  min-width: 32rpx;
  height: 32rpx;
  line-height: 32rpx;
  padding: 0 8rpx;
  border-radius: 16rpx;
  background: #f56c6c;
  color: #ffffff;
  font-size: 20rpx;
  text-align: center;
}
