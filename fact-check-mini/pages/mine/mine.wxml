<view class="container">
  <view class="mine-header" bindtap="onMenu" data-path="/pages/profile/profile" data-tab="{{false}}">
    <image wx:if="{{avatar}}" class="avatar avatar-img" src="{{avatar}}" mode="aspectFill" />
    <view wx:else class="avatar">{{initial}}</view>
    <view>
      <view class="nickname">{{userInfo.nickname || userInfo.username || '用户'}}</view>
      <view class="muted">{{userInfo.username}}</view>
    </view>
    <!-- 角色标识：让管理员一眼看出自己当前是管理端视图 -->
    <text wx:if="{{isAdmin}}" class="role-badge">管理员</text>
  </view>

  <view class="card">
    <view class="menu-item" wx:for="{{menus}}" wx:key="path" bindtap="onMenu" data-path="{{item.path}}" data-tab="{{item.tab}}">
      <view class="row menu-left">
        <text>{{item.text}}</text>
        <!-- 未读红点（P3-32） -->
        <text wx:if="{{item.badge && unread > 0}}" class="badge-dot">{{unread > 99 ? '99+' : unread}}</text>
      </view>
      <text class="arrow">›</text>
    </view>
  </view>

  <button class="btn-plain" style="margin-top: 20rpx" bindtap="onLogout">退出登录</button>
</view>
