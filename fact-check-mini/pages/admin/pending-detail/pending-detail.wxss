.category {
  font-size: 24rpx;
  color: #409eff;
  background: #ecf5ff;
  border-radius: 8rpx;
  padding: 4rpx 12rpx;
}
.content {
  font-size: 32rpx;
  color: #303133;
  line-height: 1.6;
  margin-top: 16rpx;
}
.ai-summary { margin-top: 12rpx; font-size: 26rpx; }

.evidence {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}
.evidence:last-child { border-bottom: none; }
.evidence-title { font-size: 28rpx; color: #303133; }
.snippet { font-size: 24rpx; margin-top: 8rpx; line-height: 1.5; }
.evidence-meta { justify-content: space-between; margin-top: 8rpx; }

.picker-row {
  display: flex;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
  font-size: 30rpx;
}
.field-label { margin: 24rpx 0 12rpx; font-size: 28rpx; color: #303133; }
.textarea {
  width: 100%;
  min-height: 200rpx;
  box-sizing: border-box;
  border: 1rpx solid #dcdfe6;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 28rpx;
}
.counter { text-align: right; font-size: 22rpx; margin-top: 8rpx; }
.hint { font-size: 22rpx; margin-top: 16rpx; text-align: center; }
.error { color: #f56c6c; font-size: 26rpx; }
