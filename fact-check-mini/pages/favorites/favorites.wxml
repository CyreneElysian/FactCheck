<view class="container">
  <view class="card" wx:for="{{records}}" wx:key="recordId">
    <view>{{item.content}}</view>
    <view class="muted">收藏于 {{item.createTime}}</view>
    <button class="btn-plain" style="margin-top: 12rpx" bindtap="onRemove" data-id="{{item.recordId}}">取消收藏</button>
  </view>
  <empty wx:if="{{!records.length}}" text="暂无收藏"></empty>
</view>
