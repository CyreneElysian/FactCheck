/* 个人中心（P3-32） */

.avatar-row {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.avatar-preview {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  margin-right: 24rpx;
  background: #f5f5f5;
}

.avatar-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #b0b3b8;
  font-size: 56rpx;
}

.btn-danger {
  background: #ffffff;
  color: #f56c6c;
  border: 1rpx solid #f56c6c;
  border-radius: 44rpx;
  font-size: 30rpx;
}
