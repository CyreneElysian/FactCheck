<view class="container">
  <view wx:if="{{loading}}" class="card">
    <view class="muted">加载中…</view>
  </view>

  <block wx:else>
    <view class="card">
      <view class="title">{{info.title}}</view>
      <view class="muted">
        {{info.source || '未知来源'}}{{info.category ? '　·　' + info.category : ''}}
      </view>
      <view class="muted" wx:if="{{info.publishTime}}">发布时间：{{info.publishTime}}</view>
      <image
        wx:if="{{info.coverImage}}"
        class="cover"
        src="{{info.coverImage}}"
        mode="widthFix"
        bindtap="onPreviewCover"
      />
    </view>

    <view class="card">
      <view class="body">{{info.content}}</view>
    </view>

    <view class="card" wx:if="{{info.sourceUrl}}" bindtap="onCopySource">
      <view class="row">
        <text class="link">复制原文链接</text>
        <text class="muted">›</text>
      </view>
    </view>
  </block>
</view>
