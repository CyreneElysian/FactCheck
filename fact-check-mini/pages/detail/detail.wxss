/* 检测详情页样式（P3-30） */

.verdict {
  font-size: 56rpx;
  margin: 16rpx 0 8rpx;
}

.meta-row {
  justify-content: flex-start;
}

.tag {
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  background: #f0f2f5;
  color: #909399;
}
.tag-success { background: #f0f9eb; color: #67c23a; }
.tag-warning { background: #fdf6ec; color: #e6a23c; }
.tag-danger { background: #fef0f0; color: #f56c6c; }

.content-text {
  white-space: pre-wrap;
  word-break: break-all;
}

.content-image {
  width: 100%;
  margin-top: 16rpx;
  border-radius: 8rpx;
}

.authority-hit {
  margin-top: 16rpx;
  padding: 16rpx;
  background: #f0f9eb;
  color: #67c23a;
  border-radius: 8rpx;
  font-size: 26rpx;
}

.reasoning {
  white-space: pre-wrap;
  word-break: break-all;
  color: #5a5f66;
  font-size: 26rpx;
  line-height: 1.6;
}

/* 证据条目 */
.evidence {
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f2f5;
}
.evidence:last-child { border-bottom: none; }

.evidence-title {
  font-size: 28rpx;
  color: #20232a;
  line-height: 1.5;
}

.evidence-meta {
  margin-top: 8rpx;
  flex-wrap: wrap;
}

.badge {
  margin-left: 8rpx;
  padding: 2rpx 10rpx;
  font-size: 20rpx;
  border-radius: 16rpx;
  background: #f0f9eb;
  color: #67c23a;
}

.evidence-snippet {
  margin-top: 8rpx;
  line-height: 1.5;
}

.evidence-link {
  margin-top: 8rpx;
  color: #409eff;
}

/* 操作区 */
.action-row {
  margin-top: 24rpx;
}

.flex-btn {
  flex: 1;
  margin: 0 8rpx;
}

.btn-active {
  background: #409eff;
  color: #ffffff;
}

.appeal-form {
  margin-top: 24rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #f0f2f5;
}

.picker-value {
  color: #20232a;
}

.textarea {
  width: 100%;
  height: 160rpx;
  box-sizing: border-box;
}
