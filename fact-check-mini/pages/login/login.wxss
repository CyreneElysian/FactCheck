.login-page { min-height: 100vh; background: #409eff; }
.header { padding: 120rpx 40rpx 80rpx; color: #fff; }
.header-title { font-size: 56rpx; font-weight: bold; }
.header-sub { margin-top: 12rpx; font-size: 28rpx; opacity: 0.9; }
.login-card {
  background: #fff;
  margin: 0 30rpx;
  border-radius: 16rpx;
  padding: 40rpx 30rpx;
}
.error { color: #f56c6c; margin-bottom: 20rpx; font-size: 26rpx; }

/* ---- 「创建新账号 / 绑定已有账号」二选一 ---- */
.tip { margin-top: 16rpx; text-align: center; font-size: 24rpx; }
.choose-title { margin-bottom: 24rpx; font-size: 28rpx; }
.option {
  border: 2rpx solid #e4e7ed;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}
/* 选中态：用主题色边框 + 浅底，避免与"可点击"混淆 */
.option-active { border-color: #409eff; background: #ecf5ff; }
.option-title { font-size: 30rpx; font-weight: 600; color: #303133; }
.option-desc { margin-top: 8rpx; font-size: 24rpx; color: #909399; line-height: 1.5; }
