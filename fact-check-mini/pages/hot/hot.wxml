<view class="container">
  <view class="card" wx:for="{{list}}" wx:key="recordId">
    <view class="row">
      <text class="{{item.verdict === 1 ? 'verdict-true' : item.verdict === 2 ? 'verdict-false' : 'verdict-unknown'}}">
        {{item.verdict === 1 ? '真' : item.verdict === 2 ? '假' : '无法判定'}}
      </text>
      <text class="muted">热度 {{item.hotScore}}</text>
    </view>
    <view style="margin: 12rpx 0">{{item.content}}</view>
    <view class="muted">分类：{{item.category}}　检测 {{item.hitCount}} 次</view>
  </view>
  <empty wx:if="{{!list.length}}" text="暂无热门消息"></empty>
</view>
