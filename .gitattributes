# ============================================================================
# 统一行尾与文本处理
# 仓库内统一以 LF 存储，避免 Windows / Linux 协作时的行尾噪音
# ============================================================================

# 默认：自动识别文本文件，仓库内统一 LF
* text=auto eol=lf

# ---------------------------------------------------------------------------
# 二进制文件不做任何行尾转换
# ---------------------------------------------------------------------------
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.ico   binary
*.jar   binary
*.exe   binary
*.dll   binary
*.so    binary
*.index binary
*.bin   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.eot   binary

# ---------------------------------------------------------------------------
# Windows 脚本保持 CRLF
# ---------------------------------------------------------------------------
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# ---------------------------------------------------------------------------
# 语言标记（便于 GitHub 统计与 diff 高亮）
# ---------------------------------------------------------------------------
*.java text
*.py   text
*.vue  text
*.ts   text
*.js   text
*.wxml text
*.wxss text
*.yml  text
*.yaml text
*.sql  text
*.md   text
