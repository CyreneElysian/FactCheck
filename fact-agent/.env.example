# 服务配置
AGENT_HOST=0.0.0.0
AGENT_PORT=8001

# LLM 配置（OpenAI 兼容接口）
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=sk-xxxx
LLM_MODEL=qwen-plus
# 单次 LLM 请求超时（秒）；实际值还会被 DETECT_TOTAL_BUDGET 的剩余预算进一步收紧
LLM_TIMEOUT=60
# 事实核查要求稳定输出 JSON，建议低温（0.1 左右），不建议 0.7 以上
LLM_TEMPERATURE=0.1
LLM_RETRY=2

# 搜索配置：dummy / tavily / serpapi / bocha
# ⚠️ dummy = 不联网，检测会退化为"仅凭模型自身知识判断"。
#    要体现联网核查能力，必须改为 tavily / bocha / serpapi 并填 SEARCH_API_KEY。
SEARCH_TOOL=dummy
SEARCH_API_KEY=
# 单个查询词返回条数（技术方案 §7.3 要求 top 10）
SEARCH_TOP_K=10
# 抓取网页正文的条数（技术方案 §7.3 要求 top 3）；设为 0 关闭抓取
SEARCH_FETCH_TOP=3
# 单次搜索请求超时（秒）
SEARCH_TIMEOUT=20
# 单次网页抓取超时（秒）
SEARCH_PAGE_TIMEOUT=10
# 单条证据保留的网页正文字符数（与原始摘要拼接后截断）
SEARCH_PAGE_MAX_CHARS=1500

# 检测总预算（秒）：单次 /detect 的整体耗时上限。
# 必须小于 Java 侧 fact-check.agent.timeout（默认 90s），
# 否则会出现"Java 已判失败、Agent 仍在跑"的状态不一致。
DETECT_TOTAL_BUDGET=45
# 待检测文本最大长度，超出部分截断
DETECT_MAX_TEXT_LENGTH=5000

# 去重配置（S10）
DEDUP_THRESHOLD=0.92
DEDUP_MIN_TEXT_LENGTH=8
DEDUP_TOP_K=1

# Embedding 模型
# 支持 HuggingFace 模型名，或本地已下载的模型目录路径（推荐本地路径，避免联网）
# 相对路径一律相对 fact-agent/ 解析，因此从任何目录启动都能找到
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
# 例如下载到项目 models 目录后：
# EMBEDDING_MODEL=./models/bge-model

# 数据目录（FAISS 索引与元数据；相对路径相对 fact-agent/ 解析）
AGENT_DATA_DIR=./data

# 内部鉴权 token（P2-21）
# Java 侧 AgentClient 会把该值作为 X-Internal-Token 发给 /detect、/dedup、/index/add，
# 因此必须与 Java 侧 fact-check.agent.internal-token 保持一致。
# 留空 = 内部接口一律返回 401（fail-closed，启动日志会说明原因）；生产环境务必换成随机值。
INTERNAL_TOKEN=dev-internal-token-change-me

# 来源可信度规则库（S13）路径；留空则使用 fact-agent/config/credibility_rules.json
# 相对路径相对**启动时的工作目录**解析，建议填绝对路径或用默认值
CREDIBILITY_RULES_FILE=
