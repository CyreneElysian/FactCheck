# 服务配置
AGENT_HOST=0.0.0.0
AGENT_PORT=8001

# LLM 配置（OpenAI 兼容接口）
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=sk-xxxx
LLM_MODEL=qwen-plus
LLM_TIMEOUT=60
LLM_TEMPERATURE=0.7
LLM_RETRY=2

# 搜索配置：dummy / tavily / serpapi / bocha
SEARCH_TOOL=dummy
SEARCH_API_KEY=
SEARCH_TOP_K=5
SEARCH_FETCH_TOP=2
SEARCH_PAGE_TIMEOUT=10

# 去重配置（S10）
DEDUP_THRESHOLD=0.92
DEDUP_MIN_TEXT_LENGTH=8
DEDUP_TOP_K=1

# Embedding 模型
# 支持 HuggingFace 模型名，或本地已下载的模型目录路径（推荐本地路径，避免联网）
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
# 例如下载到项目 models 目录后：
# EMBEDDING_MODEL=./models/bge-small-zh-v1.5

# 数据目录
AGENT_DATA_DIR=./data

# 内部鉴权 token（Java 调用时使用，可留空不校验）
INTERNAL_TOKEN=
