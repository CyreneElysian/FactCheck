<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.factcheck</groupId>
        <artifactId>fact-check</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>
    <artifactId>fact-check-server</artifactId>

    <properties>
        <!--
          离线仓库适配：spring-boot 2.7.3 通过 junit-bom 5.8.2 管理 junit-platform-launcher 1.8.2，
          而本机 maven 本地仓库只缓存了 junit-platform 1.9.x / junit-jupiter 5.9.3。
          覆盖该属性即可让 junit-bom 解析为 5.9.3（平台 1.9.3），测试才能离线跑起来。
          仅影响测试依赖，不影响生产代码与打包产物。
        -->
        <junit-jupiter.version>5.9.3</junit-jupiter.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.factcheck</groupId>
            <artifactId>fact-check-common</artifactId>
            <version>1.0-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>com.factcheck</groupId>
            <artifactId>fact-check-pojo</artifactId>
            <version>1.0-SNAPSHOT</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!--
          显式声明 junit-platform-launcher：surefire 3.x 在没有 launcher 时会按项目里的
          junit-platform 版本（1.9.3）去仓库抓取；显式声明后版本由 junit-bom 统一管理。
          详见上面 properties 中的 junit-jupiter.version 说明。
        -->
        <dependency>
            <groupId>org.junit.platform</groupId>
            <artifactId>junit-platform-launcher</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aop</artifactId>
        </dependency>
        <dependency>
            <groupId>mysql</groupId>
            <artifactId>mysql-connector-java</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.mybatis.spring.boot</groupId>
            <artifactId>mybatis-spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
        </dependency>
        <dependency>
            <groupId>com.alibaba</groupId>
            <artifactId>fastjson</artifactId>
        </dependency>
        <dependency>
            <groupId>com.alibaba</groupId>
            <artifactId>druid-spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>com.github.pagehelper</groupId>
            <artifactId>pagehelper-spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-websocket</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-crypto</artifactId>
        </dependency>
        <!--
          接口文档（P2-26）：knife4j 3.0.2 基于 springfox 3.0.0，UI 在 /doc.html。
          版本必须显式指定：3.0.2 是适配 Spring Boot 2.x 的最后一个大版本，
          而本地离线仓库里只有这一版（无 springdoc/springfox-boot-starter 之外的版本）。
          已知兼容要求：springfox 3.0.0 配 Boot 2.6+ 必须使用 ant_path_matcher 路径匹配策略，
          见 application.yml 中的 spring.mvc.pathmatch.matching-strategy。
        -->
        <dependency>
            <groupId>com.github.xiaoymin</groupId>
            <artifactId>knife4j-spring-boot-starter</artifactId>
            <version>3.0.2</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <!--
              surefire 版本由**父 pom 的 pluginManagement** 统一指定为 3.1.2（见顶层 pom.xml）。
              此处不再重复写 <version>，避免两处版本不一致。

              背景：spring-boot 2.7.3 默认的 2.22.2 需要 surefire-junit-platform:2.22.2，
              本地离线仓库中没有该构件（只有 3.1.2），不覆盖会导致离线环境无法执行任何 JUnit 5 测试；
              容器里构建时还会因为要从 Central 现下该构件而受网络抖动影响。
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
          对外分发时才排除本地密钥文件。

          背景（这是个踩过的坑）：
          原先在默认 build 里排除了 application-local.yml，结果不只是 jar，
          连 target/classes 里也没有这个文件；而 IDEA / mvn spring-boot:run 运行时
          用的正是 target/classes，于是激活 local profile 后
          ${fact-check.datasource.*} 全部无法解析，启动直接报
          java.sql.SQLException: ${fact-check.datasource.driver-class-name}。

          所以默认构建不排除（保证 IDE 与本地直接能跑），
          需要构建"可分发产物"（CI / Docker / 发给别人）时加 -Pdist：
              mvn clean package -Pdist -DskipTests
        -->
        <profile>
            <id>dist</id>
            <build>
                <resources>
                    <resource>
                        <directory>src/main/resources</directory>
                        <excludes>
                            <exclude>application-local.yml</exclude>
                        </excludes>
                    </resource>
                </resources>
            </build>
        </profile>
    </profiles>
</project>
