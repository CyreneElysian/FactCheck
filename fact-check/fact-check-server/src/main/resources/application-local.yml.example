# ============================================================================
# application-local.yml 模板
#
# 使用方式：
#   1) 复制本文件为 application-local.yml（同目录）
#   2) 填入你自己的真实密钥
#   3) 启动时激活 local profile：环境变量 FACTCHECK_PROFILE=local
#      或启动参数 --spring.profiles.active=local
#      （默认值就是 dev,local，所以通常什么都不用设）
#
# application-local.yml 已在 .gitignore 中，不会被提交。
# ============================================================================
fact-check:
  # ⚠️ JWT 密钥是**必填**的：application.yml 里这两个键刻意不带默认值，
  #    未设置会导致启动失败（报 Could not resolve placeholder）。
  #    本地裸机跑（例如 IDEA 里直接 Run）就在这里填；容器化部署则用环境变量注入。
  #    要求：≥32 字节。生成方式：
  #      PowerShell : -join ((1..64) | ForEach-Object { '{0:x}' -f (Get-Random -Maximum 16) })
  #      Linux/macOS: openssl rand -hex 32
  #    两个值不要相同；换掉密钥后已签发的 token 会失效（重新登录即可）。
  jwt:
    user-secret-key: your-local-dev-user-secret-at-least-32-bytes-long
    admin-secret-key: your-local-dev-admin-secret-at-least-32-bytes-long
  datasource:
    driver-class-name: com.mysql.cj.jdbc.Driver
    host: localhost
    port: 3306
    database: fact_check
    username: root
    password: "your-mysql-password"
  alioss:
    endpoint: https://oss-cn-beijing.aliyuncs.com
    access-key-id: your-oss-access-key-id
    access-key-secret: your-oss-access-key-secret
    bucket-name: your-bucket-name
  redis:
    host: localhost
    port: 6379
    # 本地 Redis 未设密码时留空
    password: ""
    database: 0
  wechat:
    appid: your-wechat-appid
    secret: your-wechat-appsecret
