# ============================================================================
# application-local.yml 模板
#
# 使用方式：
#   1) 复制本文件为 application-local.yml（同目录）
#   2) 填入你自己的真实密钥
#   3) 启动时激活 local profile：环境变量 FACTCHECK_PROFILE=local
#      或启动参数 --spring.profiles.active=local
#
# application-local.yml 已在 .gitignore 中，不会被提交。
# ============================================================================
fact-check:
  datasource:
    driver-class-name: com.mysql.cj.jdbc.Driver
    host: localhost
    port: 3306
    database: fact_check
    username: root
    password: "your-mysql-password"
  alioss:
    endpoint: https://oss-cn-beijing.aliyuncs.com
    access-key-id: your-oss-access-key-id
    access-key-secret: your-oss-access-key-secret
    bucket-name: your-bucket-name
  redis:
    host: localhost
    port: 6379
    # 本地 Redis 未设密码时留空
    password: ""
    database: 0
  wechat:
    appid: your-wechat-appid
    secret: your-wechat-appsecret
